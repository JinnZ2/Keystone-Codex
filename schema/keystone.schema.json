{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keystone",
  "type": "object",
  "required": [
    "id",
    "name",
    "domain",
    "region",
    "era",
    "summary",
    "metrics",
    "claims",
    "evidence",
    "unlocks"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "enum": [
        "ecological",
        "economic",
        "social",
        "governance",
        "information",
        "material",
        "ethical",
        "infrastructure"
      ]
    },
    "region": {
      "type": "string"
    },
    "era": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "required": [
        "longevity_years",
        "replication_regions",
        "decentralization_score"
      ],
      "properties": {
        "longevity_years": {
          "type": "integer",
          "minimum": 0
        },
        "replication_regions": {
          "type": "integer",
          "minimum": 0
        },
        "decentralization_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ethical_alignment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "archaeological_record",
              "peer_reviewed_study",
              "ethnographic_record",
              "primary_text",
              "engineering_record",
              "replication_record",
              "radiocarbon_date",
              "standards_spec",
              "field_measurement",
              "oral_tradition_encoded"
            ],
            "description": "Evidence taxonomy. This enum is the single source of truth: src/validate.py derives VALID_EVIDENCE_TYPES from it and hypothesis H008 checks that every type listed here is actually used somewhere in the corpus. Documented in CITATIONS.md."
          },
          "source": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "quality": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "unlocks": {
      "type": "array",
      "description": "Downstream families or keystones this entry enabled. Each target must resolve to another entry id or to a term in rules/lineage_terms.json.",
      "items": {
        "type": "string"
      }
    },
    "longevity_basis": {
      "type": "string",
      "description": "Required whenever metrics.longevity_years cannot be derived from era.end - era.start within 25%. States what the number actually measures \u2014 attested continuous operation, persistence after abandonment, or a conservative floor under a contested start date. Added after run-001-baseline falsified H003."
    },
    "notes": {
      "type": "string"
    }
  }
}
